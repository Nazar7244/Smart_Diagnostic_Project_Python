QWidget {
    color: #e6eff9;
    font-family: "Segoe UI";
    font-size: 12px;
}
QMainWindow, #workspace, QScrollArea, #surface { background: #0c1016; }
QScrollArea { border: none; }
#sidebar { background: #0e131b; border-right: 1px solid #202936; }
#topbar { background: #0e131b; border-bottom: 1px solid #202936; }
#panel {
    background: qlineargradient(x1:0,y1:0,x2:1,y2:1,stop:0 #131a23,stop:1 #10161f);
    border: 1px solid #202c3a;
    border-radius: 11px;
}
#sidebarResult {
    background: qlineargradient(x1:0,y1:0,x2:1,y2:1,stop:0 #14252e,stop:1 #101b24);
    border: 1px solid #223d4d;
    border-radius: 9px;
}
#aiPanel, #readout, #systemCard {
    background: #111c29;
    border: 1px solid #263f57;
    border-radius: 7px;
}
#systemCard { background: #111821; border-color: #232f3d; }
#header { border-bottom: 1px solid #212d3b; }
#divider { background: #253240; }
#brandMark {
    background: qlineargradient(x1:0,y1:0,x2:1,y2:1,stop:0 #1b3b60,stop:1 #122237);
    border: 1px solid #378df2;
    border-radius: 10px;
}
#brandBar { background: #63b3ff; border-radius: 1px; }
#brandName { font-size: 20px; font-weight: 700; }
#title { font-size: 16px; font-weight: 650; }
#metric { font-size: 24px; font-weight: 650; }
#health {
    color: #b9dcff;
    border: 3px solid #4a94ca;
    border-radius: 21px;
    font-size: 12px;
    font-weight: 650;
}
#normal, #checkMark {
    color: #54d09e;
    background: #16372f;
    border: 3px solid #3ba37c;
    border-radius: 21px;
    font-size: 22px;
}
#checkMark { border-width: 1px; }
#accent { color: #65b8f6; }
#green, #hint { color: #59cfa2; }
#muted, #micro, #technical { color: #829bb3; font-size: 10px; }
#micro { color: #7692ac; font-size: 9px; }
#technical { color: #7290ad; }
#tag { color: #83a9cf; background: #101923; border: 1px solid #294057; border-radius: 5px; padding: 5px 8px; font-size: 9px; }
#notice { color: #a8d7ff; background: #132438; border: 1px solid #28496d; border-radius: 7px; }
#audioStatus { font-size: 11px; }
#aiResult { color: #b9cee3; background: #0f1720; border: 1px solid #263f57; border-radius: 6px; padding: 6px; font-size: 11px; }
QPushButton, QToolButton, QLineEdit, QComboBox {
    background: #0f1720;
    border: 1px solid #293c51;
    border-radius: 6px;
    padding: 7px 10px;
}
QPushButton, QToolButton { color: #b9cee3; }
QPushButton:hover, QToolButton:hover, QPushButton:checked { color: #edf6ff; background: #18304a; border-color: #38618b; }
QPushButton:focus, QToolButton:focus, QLineEdit:focus, QComboBox:focus { border-color: #4a9bea; }
QPushButton:disabled, QToolButton:disabled { color: #667788; background: #121821; border-color: #232d39; }
QToolButton#notifications::menu-indicator { image: none; }
QPushButton#nav { text-align: left; color: #9bacc0; padding-left: 13px; border-color: transparent; background: transparent; font-size: 14px; }
QPushButton#nav:hover { color: #e6f1ff; background: #151e2b; }
QPushButton#nav:checked {
    color: #e6f1ff;
    background: qlineargradient(x1:0,y1:0,x2:1,y2:0,stop:0 #162b44,stop:1 #111c29);
    border: 1px solid #284564;
    border-left: 2px solid #408df2;
}
QPushButton#primary {
    color: white;
    font-weight: 700;
    border: 1px solid #469cfa;
    background: qlineargradient(x1:0,y1:0,x2:0,y2:1,stop:0 #328bed,stop:1 #1a5cb5);
}
QPushButton#primary:hover { background: #3186dd; }
QPushButton#outline { background: #142638; border-color: #2e5070; color: #acd4ff; }
QPushButton#outline:hover { background: #1c3852; }
QPushButton#record { padding: 0; color: #fb6680; background: #351b28; border: 1px solid #73354a; border-radius: 19px; font-size: 22px; }
QPushButton#record:hover { background: #562537; }
QPushButton#record:disabled { color: #7f6972; background: #231d26; border-color: #3a2d37; }
QLineEdit, QComboBox { selection-background-color: #28588a; }
QComboBox::drop-down { border: 0; width: 22px; }
QComboBox::down-arrow { image: url("COMBO_ARROW"); width: 10px; height: 7px; }
QComboBox QAbstractItemView { background: #152130; selection-background-color: #254664; }
QProgressBar { border: 0; background: #263846; border-radius: 2px; }
QProgressBar::chunk { background: qlineargradient(x1:0,y1:0,x2:1,y2:0,stop:0 #29917c,stop:1 #55d5a8); border-radius: 2px; }
QTableWidget { background: transparent; border: 0; gridline-color: #273342; selection-background-color: #19334b; }
QHeaderView { background: transparent; }
QHeaderView::section { color: #829db9; background: #111923; border: none; padding: 6px 3px; font-size: 9px; }
QToolButton#tableAction { padding: 5px 6px; font-size: 10px; }
QScrollBar:vertical { width: 8px; background: transparent; margin: 1px; }
QScrollBar::handle:vertical { background: #293848; border-radius: 3px; min-height: 26px; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical { background: transparent; }
QMenu { background: #14202d; border: 1px solid #2a3f55; border-radius: 6px; padding: 8px; }

/* ===================== SmartDiagnost PRO additions ===================== */
QToolTip { background: #14202d; color: #e6eff9; border: 1px solid #2a3f55; padding: 4px 6px; }
QDialog, QMessageBox { background: #0e131b; }
QMessageBox QLabel { color: #e6eff9; font-size: 13px; }
QDialog#authDialog { background: #0e131b; }

/* Authentication */
#authRoot, #authSide { background: #0c1016; }
#authCard {
    background: qlineargradient(x1:0,y1:0,x2:1,y2:1,stop:0 #141c27,stop:1 #10161f);
    border: 1px solid #22303f;
    border-radius: 16px;
}
#authTitle { font-size: 22px; font-weight: 700; color: #f1f7ff; }
#heroTitle { font-size: 30px; font-weight: 700; color: #f1f7ff; }
#heroText { font-size: 14px; color: #9bb2c8; }
#heroBullet { font-size: 13px; color: #c3d6e8; }
QLabel#error { color: #f7a1ae; background: #2a1620; border: 1px solid #5a2a38; border-radius: 7px; padding: 8px 10px; }
QPushButton#link { background: transparent; border: none; color: #6fb4f5; padding: 0; font-size: 11px; }
QPushButton#link:hover { color: #a5d3ff; background: transparent; }
QCheckBox { spacing: 8px; color: #b9cee3; }
QCheckBox::indicator { width: 16px; height: 16px; border: 1px solid #38618b; border-radius: 4px; background: #0f1720; }
QCheckBox::indicator:hover { border-color: #4a9bea; }
QCheckBox::indicator:checked { background: #2f86e8; border-color: #4fd8ee; image: url("CHECK_MARK"); }
QCheckBox:disabled { color: #667788; }
QProgressBar#strength { background: #1a2634; border-radius: 2px; }
QProgressBar#strength::chunk { background: #f2788a; border-radius: 2px; }
QProgressBar#strength[level="2"]::chunk { background: #f4ba77; }
QProgressBar#strength[level="3"]::chunk { background: #59cfa2; }
QProgressBar#strength[level="4"]::chunk { background: #4fd8ee; }
QLabel#resetCode {
    font-family: Consolas, "Cascadia Mono", monospace; font-size: 28px; font-weight: 700; color: #4fd8ee;
    background: #0f1720; border: 1px dashed #2e5070; border-radius: 8px; padding: 14px;
}

/* Pages and dashboard widgets */
#pageTitle { font-size: 22px; font-weight: 700; color: #f1f7ff; }
#welcome { font-size: 26px; font-weight: 700; color: #f1f7ff; }
#clock { font-size: 28px; font-weight: 600; color: #e6f1ff; }
#statCard {
    background: qlineargradient(x1:0,y1:0,x2:1,y2:1,stop:0 #131a23,stop:1 #10161f);
    border: 1px solid #202c3a;
    border-radius: 11px;
}
#statValue { font-size: 30px; font-weight: 700; color: #f1f7ff; }
#activityRow { background: #111923; border: 1px solid #1f2b3a; border-radius: 8px; }
#activityRow:hover { background: #152233; border-color: #2e5070; }
QPushButton#module {
    text-align: left; padding: 10px 12px; background: #111923; border: 1px solid #223244;
    border-radius: 9px; color: #d4e4f5; font-size: 12px;
}
QPushButton#module:hover { background: #16283b; border-color: #2f7a96; color: #ffffff; }

/* Badges */
QLabel#badge { border-radius: 10px; padding: 3px 10px; font-size: 10px; font-weight: 600; border: 1px solid; }
QLabel#badge[state="success"] { color: #59cfa2; background: #10261f; border-color: #235a47; }
QLabel#badge[state="warning"] { color: #f4ba77; background: #2a2113; border-color: #5c4624; }
QLabel#badge[state="failed"]  { color: #f2788a; background: #2a1520; border-color: #5a2a38; }
QLabel#badge[state="pending"] { color: #7cb8f0; background: #12233a; border-color: #29496d; }
QLabel#roleBadge { border-radius: 9px; padding: 2px 9px; font-size: 9px; font-weight: 700; border: 1px solid; }
QLabel#roleBadge[role="administrator"] { color: #4fd8ee; background: #0f2830; border-color: #1f5a68; }
QLabel#roleBadge[role="engineer"]      { color: #8fb8ff; background: #14233f; border-color: #2c4a7d; }
QLabel#roleBadge[role="mechanic"]      { color: #7fd9c4; background: #10282a; border-color: #20544f; }
QLabel#roleBadge[role="guest"]         { color: #aab8c6; background: #1a222c; border-color: #2d3946; }

/* Sidebar user card */
#userCard { background: #111821; border: 1px solid #232f3d; border-radius: 9px; }
QLabel#avatar {
    background: qlineargradient(x1:0,y1:0,x2:1,y2:1,stop:0 #1b3b60,stop:1 #122237);
    border: 1px solid #378df2; border-radius: 20px; font-weight: 700; font-size: 13px; color: #cfe6ff;
}
QPushButton#userButton { text-align: left; background: transparent; border: none; padding: 2px 4px; color: #e6f1ff; }
QPushButton#userButton:hover { background: #151e2b; }
QToolButton#logout { padding: 0; border: 1px solid #4a2a35; background: #241820; }
QToolButton#logout:hover { background: #3a1f2b; border-color: #7a3a4c; }

/* Inputs */
QSpinBox, QDoubleSpinBox, QDateEdit, QPlainTextEdit {
    background: #0f1720; border: 1px solid #293c51; border-radius: 6px; padding: 6px 8px;
    selection-background-color: #28588a;
}
QSpinBox:focus, QDoubleSpinBox:focus, QDateEdit:focus, QPlainTextEdit:focus { border-color: #4a9bea; }
QSpinBox:disabled, QDoubleSpinBox:disabled, QDateEdit:disabled, QLineEdit:disabled, QComboBox:disabled {
    color: #667788; background: #121821; border-color: #232d39;
}
QCalendarWidget QWidget { background: #14202d; color: #e6eff9; }
QCalendarWidget QAbstractItemView { selection-background-color: #254664; selection-color: #ffffff; }
QPushButton#tableAction, QToolButton#tableAction { padding: 5px 8px; }

QSpinBox::up-button, QDoubleSpinBox::up-button { subcontrol-origin: border; subcontrol-position: top right; width: 20px; border: none; background: transparent; }
QSpinBox::down-button, QDoubleSpinBox::down-button { subcontrol-origin: border; subcontrol-position: bottom right; width: 20px; border: none; background: transparent; }
QSpinBox::up-arrow, QDoubleSpinBox::up-arrow { image: url("CHEVRON_UP"); width: 9px; height: 6px; }
QSpinBox::down-arrow, QDoubleSpinBox::down-arrow { image: url("COMBO_ARROW"); width: 9px; height: 6px; }
QSpinBox::up-button:hover, QSpinBox::down-button:hover, QDoubleSpinBox::up-button:hover, QDoubleSpinBox::down-button:hover { background: #18304a; }
QDateEdit::drop-down { border: 0; width: 22px; }
QDateEdit::down-arrow { image: url("COMBO_ARROW"); width: 10px; height: 7px; }
QPushButton#outline:disabled, QPushButton#primary:disabled { color: #667788; background: #121821; border-color: #232d39; }
